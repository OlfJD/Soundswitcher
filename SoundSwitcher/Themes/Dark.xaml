<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Dark: neutral greys, white as the only accent -->
    <SolidColorBrush x:Key="BgBrush" Color="#1C1C1F"/>
    <SolidColorBrush x:Key="RaiseBrush" Color="#26262A"/>
    <SolidColorBrush x:Key="RaiseHoverBrush" Color="#2E2E33"/>
    <SolidColorBrush x:Key="PopupBrush" Color="#232327"/>
    <SolidColorBrush x:Key="FgBrush" Color="#F4F4F5"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8F8F98"/>
    <SolidColorBrush x:Key="LineBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="Line2Brush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#F4F4F5"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#111113"/>
    <SolidColorBrush x:Key="TileActiveBrush" Color="#3B3B3F"/>
    <SolidColorBrush x:Key="TileActiveFgBrush" Color="#F4F4F5"/>
    <SolidColorBrush x:Key="BadgeBrush" Color="#F4F4F5"/>
    <SolidColorBrush x:Key="BadgeFgBrush" Color="#111113"/>
    <sys:Double x:Key="ShadowOpacity">0.5</sys:Double>
</ResourceDictionary>
