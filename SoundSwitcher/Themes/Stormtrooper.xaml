<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Stormtrooper: white shell, hard black details; the active tile inverts to solid black -->
    <SolidColorBrush x:Key="BgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RaiseBrush" Color="#F3F3F4"/>
    <SolidColorBrush x:Key="RaiseHoverBrush" Color="#E9E9EB"/>
    <SolidColorBrush x:Key="PopupBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FgBrush" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#6E6E76"/>
    <SolidColorBrush x:Key="LineBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="Line2Brush" Color="#33000000"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#29000000"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TileActiveBrush" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="TileActiveFgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BadgeBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BadgeFgBrush" Color="#0A0A0A"/>
    <sys:Double x:Key="ShadowOpacity">0.18</sys:Double>
</ResourceDictionary>
