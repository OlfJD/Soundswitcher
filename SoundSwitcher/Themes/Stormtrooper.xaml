<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Stormtrooper ("Armour"): white shell, grey plates, bold 2 px black outlines on every panel,
         tile and control. Greys follow Google's hardware palette; the active tile inverts to solid black. -->
    <SolidColorBrush x:Key="BgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RaiseBrush" Color="#E8EAED"/>
    <SolidColorBrush x:Key="RaiseHoverBrush" Color="#DADCE0"/>
    <SolidColorBrush x:Key="PopupBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FgBrush" Color="#000000"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#4A4D52"/>
    <SolidColorBrush x:Key="LineBrush" Color="#000000"/>
    <SolidColorBrush x:Key="Line2Brush" Color="#BDC1C6"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#000000"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#000000"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TileActiveBrush" Color="#000000"/>
    <SolidColorBrush x:Key="TileActiveFgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BadgeBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BadgeFgBrush" Color="#000000"/>
    <sys:Double x:Key="ShadowOpacity">0.2</sys:Double>

    <!-- Outlines and weights -->
    <SolidColorBrush x:Key="OutlineBrush" Color="#000000"/>
    <Thickness x:Key="OutlineThickness">2</Thickness>
    <Thickness x:Key="WindowBorderThickness">2</Thickness>
    <SolidColorBrush x:Key="TileBorderBrush" Color="#000000"/>
    <Thickness x:Key="TileBorderThickness">2</Thickness>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#000000"/>
    <Thickness x:Key="ControlBorderThickness">2</Thickness>
    <sys:Double x:Key="DividerHeight">2</sys:Double>
    <sys:Double x:Key="TrackHeight">6</sys:Double>
    <sys:Double x:Key="ThumbSize">16</sys:Double>
    <SolidColorBrush x:Key="ThumbFillBrush" Color="#FFFFFF"/>
    <sys:Double x:Key="ThumbStrokeThickness">2</sys:Double>
</ResourceDictionary>
