<Window x:Class="SoundSwitcher.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SoundSwitcher.Views"
        mc:Ignorable="d"
        Title="SoundSwitcher"
        Width="344"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="{StaticResource AppFont}"
        FontSize="13"
        Foreground="{DynamicResource FgBrush}"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <Storyboard x:Key="FadeInStory">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.16">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="6" To="0" Duration="0:0:0.16">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="Divider" TargetType="{x:Type Border}">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource LineBrush}"/>
        </Style>
        <Style x:Key="Muted" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Window.RenderTransform>
        <TranslateTransform Y="0"/>
    </Window.RenderTransform>

    <!-- Margin leaves room for the shadow -->
    <Grid Margin="12">
        <Border Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource WindowBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="10"
                MouseLeftButtonDown="Window_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" Color="#000000" Opacity="{DynamicResource ShadowOpacity}" ShadowDepth="6" Direction="270"/>
            </Border.Effect>

            <StackPanel>
                <!-- SETTINGS (unfolds upward; tiles stay anchored at the bottom) -->
                <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Margin="0,0,0,10">
                    <!-- Which devices the two tiles switch between -->
                    <Border Background="{DynamicResource RaiseBrush}" CornerRadius="12" Padding="12,0">
                        <StackPanel>
                            <Grid Height="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Left tile" Style="{StaticResource Muted}"/>
                                <ComboBox x:Name="DeviceAComboBox" Grid.Column="1" Margin="12,0,0,0"
                                          Style="{StaticResource FlatCombo}"
                                          ItemTemplate="{StaticResource DeviceNameTemplate}"
                                          SelectionChanged="DeviceAComboBox_SelectionChanged"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Height="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Right tile" Style="{StaticResource Muted}"/>
                                <ComboBox x:Name="DeviceBComboBox" Grid.Column="1" Margin="12,0,0,0"
                                          Style="{StaticResource FlatCombo}"
                                          ItemTemplate="{StaticResource DeviceNameTemplate}"
                                          SelectionChanged="DeviceBComboBox_SelectionChanged"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Preferences -->
                    <Border Background="{DynamicResource RaiseBrush}" CornerRadius="12" Padding="12,0" Margin="0,8,0,0">
                        <StackPanel>
                            <Grid Height="40">
                                <TextBlock Text="Theme" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource BgBrush}" CornerRadius="8" Padding="2"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ThemeDarkRadio" Content="Dark" GroupName="Theme"
                                                     Style="{StaticResource Segment}" Checked="ThemeRadio_Checked"/>
                                        <RadioButton x:Name="ThemeStormtrooperRadio" Content="Stormtrooper" GroupName="Theme"
                                                     Style="{StaticResource Segment}" Checked="ThemeRadio_Checked"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <CheckBox x:Name="StartupCheckBox"
                                      Style="{StaticResource ModernSwitch}"
                                      Content="Start with Windows"
                                      Height="40"
                                      Checked="StartupCheckBox_Changed"
                                      Unchecked="StartupCheckBox_Changed"/>
                            <Border Style="{StaticResource Divider}"/>
                            <CheckBox x:Name="DirectTrayToggleCheckBox"
                                      Style="{StaticResource ModernSwitch}"
                                      Content="Tray click switches device"
                                      Height="40"
                                      Checked="DirectTrayToggleCheckBox_Changed"
                                      Unchecked="DirectTrayToggleCheckBox_Changed"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="6,12,6,0">
                        <Button Content="Sound settings" Style="{StaticResource TextButton}"
                                HorizontalAlignment="Left" Click="OpenWindowsSoundSettings_Click"/>
                        <Button Content="Quit" Style="{StaticResource TextButton}"
                                Foreground="{DynamicResource MutedBrush}"
                                HorizontalAlignment="Right" Click="QuitBtn_Click"/>
                    </Grid>
                </StackPanel>

                <!-- HEADER -->
                <Grid Margin="6,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Output" FontSize="12" Style="{StaticResource Muted}"/>
                    <Button x:Name="SettingsBtn" Grid.Column="1" Style="{StaticResource IconButton}"
                            Click="SettingsBtn_Click" ToolTip="Settings">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconGear}" Style="{StaticResource IconPath}"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="CloseBtn" Grid.Column="2" Style="{StaticResource IconButton}"
                            Click="CloseBtn_Click" ToolTip="Hide to tray">
                        <Viewbox Width="15" Height="15">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>

                <!-- DEVICE TILES -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ToggleButton x:Name="TileA" Grid.Column="0" Style="{StaticResource DeviceTile}" Click="Tile_Click">
                        <StackPanel>
                            <Viewbox Width="22" Height="22" HorizontalAlignment="Left">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="TileAIcon" Data="{StaticResource IconHeadphones}" Style="{StaticResource IconPath}"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="TileAName" Text="Device" FontWeight="SemiBold" Margin="0,14,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TileADetail" Text="" FontSize="11.5" Opacity="0.6" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton x:Name="TileB" Grid.Column="2" Style="{StaticResource DeviceTile}" Click="Tile_Click">
                        <StackPanel>
                            <Viewbox Width="22" Height="22" HorizontalAlignment="Left">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="TileBIcon" Data="{StaticResource IconSpeaker}" Style="{StaticResource IconPath}"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="TileBName" Text="Device" FontWeight="SemiBold" Margin="0,14,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TileBDetail" Text="" FontSize="11.5" Opacity="0.6" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </ToggleButton>
                </Grid>

                <!-- VOLUME -->
                <Grid Margin="2,8,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="MuteBtn" Style="{StaticResource IconButton}" Click="MuteBtn_Click" ToolTip="Mute">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="MuteVectorPath" Style="{StaticResource IconPath}"
                                      Data="M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z M16 9a5 5 0 0 1 0 6 M19.364 18.364a9 9 0 0 0 0-12.728"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Slider x:Name="VolumeSlider" Grid.Column="1" Margin="8,0,10,0"
                            Style="{StaticResource ModernSlider}"
                            Minimum="0" Maximum="100"
                            ValueChanged="VolumeSlider_ValueChanged"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="VolumeText" Grid.Column="2" Text="100"
                               Style="{StaticResource Muted}"
                               Typography.NumeralAlignment="Tabular"
                               MinWidth="24" TextAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
