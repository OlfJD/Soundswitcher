<Window x:Class="SoundSwitcher.Views.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SoundSwitcher menu"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        ResizeMode="NoResize"
        FontFamily="{StaticResource AppFont}"
        FontSize="13"
        Foreground="{DynamicResource FgBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="MenuItemButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,8,16,8">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RaiseHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RaiseBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Same construction as the flyout: scaled as a whole, shadow on its own layer, margin for the shadow -->
    <Grid x:Name="Root" Margin="10" LayoutTransform="{StaticResource UiScale}">
        <Border Background="{DynamicResource BgBrush}" CornerRadius="12" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Color="#000000" Opacity="{DynamicResource ShadowOpacity}" ShadowDepth="4" Direction="270"/>
            </Border.Effect>
        </Border>
        <Border Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource WindowBorderBrush}"
                BorderThickness="{DynamicResource WindowBorderThickness}"
                CornerRadius="12"
                Padding="4">
            <Button x:Name="ExitButton" Style="{StaticResource MenuItemButton}" Click="ExitButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="15" Height="15">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12 2v10 M18.4 6.6a9 9 0 1 1-12.77.04" Style="{StaticResource IconPath}"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Exit" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Border>
    </Grid>
</Window>
